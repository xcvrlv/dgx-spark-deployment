# Linux account used for passwordless SSH to the four management addresses.
SPARK_SSH_USER=

# Optional private key. Leave empty to use the normal SSH agent/config.
SPARK_SSH_KEY=

# For a Hugging Face cache snapshot, mount the models--ORG--NAME root so the
# snapshot's relative symlinks can still reach the sibling blobs directory.
# MODEL_REVISION=<40-character snapshot revision>
# MODEL_HOST_PATH=/home/USER/.cache/huggingface/hub/models--ORG--NAME/snapshots/REVISION
# MODEL_MOUNT_HOST_PATH=/home/USER/.cache/huggingface/hub/models--ORG--NAME
# MODEL_MOUNT_CONTAINER_PATH=/model-mount
# MODEL_CONTAINER_PATH=/model-mount/snapshots/REVISION

# Performance profiles are selected when invoking the launcher, for example:
# PROFILE_FILE=profiles/glm53-cudagraph.env bash scripts/launch-glm53-flash.sh start
# Values set below still override the selected profile.
# MAX_NUM_BATCHED_TOKENS=32768
# MTP_SPECULATIVE_TOKENS=0
