ARG BASE_IMAGE=spark-vllm-ds41:mx-fp4-engram-v2
FROM ${BASE_IMAGE}
USER root
COPY patches /opt/ds41/patches
RUN python3 - <<'PY'
import importlib.util, pathlib, subprocess
root = pathlib.Path(importlib.util.find_spec('b12x').origin).parent.parent
subprocess.run(['python3','/opt/ds41/patches/performance.py','--root',str(root)],check=True)
PY
LABEL local.ds41.performance=disk-sector-v1
