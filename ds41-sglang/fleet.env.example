# Run from Spark 1. Set interface names and SSH key for the actual Linux hosts.
HEAD_IP=192.168.0.1
WORKER_IPS="192.168.0.2 192.168.0.3 192.168.0.4"
WORKER_HOSTS="$WORKER_IPS"
WORKER_USER=juho
SSH_IDENTITY=$HOME/.ssh/id_ed25519
WORKER_DIR=/home/juho/.local/share/ds41-sglang
# Discover the head's CX0 interface; worker interface names must match or be configured.
FABRIC_IFACE=$(ip -o -4 addr show | awk '$4 == "192.168.0.1/24" {print $2; exit}')
: "${FABRIC_IFACE:?Set FABRIC_IFACE to the CX0 interface name}"
GLOO_SOCKET_IFNAME=$FABRIC_IFACE
NCCL_SOCKET_IFNAME=$FABRIC_IFACE
IB_HCA=rocep1s0f0,roceP2p1s0f0
NCCL_IB_GID_INDEX=3
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_DEBUG=WARN
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
NCCL_HOST_DIR=$HOME/nccl-2.30.7
# Original FP8 Engram checkpoint, NOT the existing FP4-Engram hybrid.
MODEL_DIR=$HOME/NewModels/DeepSeek-V4.1-Flash
COMMON_MODEL=/var/tmp/DeepSeek-V4.1-Flash
BASE_IMAGE=lmsysorg/sglang@sha256:b4a4745fab5393dc0aca573fe754b86477f57691c9e971390b21102d3d94ebf9
IMAGE=ds41-sglang-tp4:topk-e59e6eb-v1
HEAD_CTN=ds41-sglang-head
WORKER_CTN=ds41-sglang-worker
NFS_SHARE=1
NFS_VOLUME=ds41-sglang-fp8-weights
NFS_EXPORT_NAME=ds41-sglang-fp8
NFS_SERVER_IPS=192.168.0.1
NFS_CLIENTS=192.168.0.0/24
NNODES=4
TP_SIZE=4
EP_SIZE=4
DIST_PORT=20000
PORT=8000
OFFLOAD_MODE=nvme
ENGRAM_DIR=$HOME/.cache/ds41-sglang-fp8-engram
WORKER_ENGRAM_DIR=/home/juho/.cache/ds41-sglang-fp8-engram
DSV41_PACKED_DIR=/engram
DSV41_CACHE_GIB=0
DSV41_RESIDENT_SCALES=0
DSV41_IO_THREADS=96
DSV41_TP_PAD=0
CONTEXT_LENGTH=1048576
MEM_FRACTION_STATIC=0.90
HEAD_MEM_FRACTION_STATIC=0.90
MAX_TOTAL_TOKENS=4000000
MAX_RUNNING_REQUESTS=8
CHUNKED_PREFILL_SIZE=4096
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=5
DSPARK_SPS_TABLE=/state/dspark_sps.json
DSPARK_STS_TABLE=/state/dspark_sts.json
DSV41_MXFP8_BACKEND=b12x
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192
EXTRA_SGLANG_ARGS="--fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800"
SKIP_PREPARE=1
SKIP_VERIFY=1
SKIP_SMOKE=0
SMOKE_QUICK=1
