FROM spark-vllm-glm53-exl3:r22-dflash2-sm121-v12

COPY overlay/patch_r22_v13.py overlay/gb10_rotations.py overlay/smoke_r22_v13.py /opt/compose/
RUN python3 - <<'PY'
from pathlib import Path
import sys
import b12x
import vllm
sys.path.insert(0, "/opt/compose")
from patch_r22_v13 import patch
for b, v in ((Path("/opt/b12x-r22/b12x"), Path("/opt/vllm-r22/vllm")),
             (Path(b12x.__file__).parent, Path(vllm.__file__).parent)):
    patch(b, v)
    patch(b, v, check=True)
PY

ENV VLLM_GB10_DENSE_ROTATIONS=1
LABEL local-inference.v13-overlay="glm53-r22-v13-1"
