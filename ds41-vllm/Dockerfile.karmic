# syntax=docker/dockerfile:1.7
ARG KK_IMAGE
FROM ${KK_IMAGE}
ARG VLLM_COMMIT
ARG B12X_COMMIT
USER root
ENV CUDA_HOME=/usr/local/cuda \
    CUTE_DSL_ARCH=sm_121a \
    TORCH_CUDA_ARCH_LIST=12.1a \
    FLASHINFER_CUDA_ARCH_LIST=12.1f \
    TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas \
    B12X_ROCE_CACHE_DIR=/opt/b12x-roce-cache

RUN test "$(uname -m)" = aarch64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential git pkg-config libibverbs-dev ibverbs-providers \
       rdma-core ibverbs-utils iproute2 liburing-dev python3-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --filter=blob:none --no-checkout https://github.com/local-inference-lab/b12x.git /opt/b12x \
    && git -C /opt/b12x checkout --detach "${B12X_COMMIT}" \
    && test "$(git -C /opt/b12x rev-parse HEAD)" = "${B12X_COMMIT}" \
    && python3 -m pip install --no-cache-dir cuda-python 'rich>=13' pytest \
    && python3 -c 'from importlib.metadata import version; assert version("nvidia-cutlass-dsl") == "4.7.1"' \
    && python3 -m pip install --no-cache-dir --no-deps /opt/b12x \
    && python3 -c 'from importlib.metadata import version; assert version("nvidia-cutlass-dsl") == "4.7.1"'

# b12x currently declares CUTLASS DSL 4.6.2 while Karmic pins 4.7.1. Preserve
# Karmic's dependency rather than silently downgrading it; GPU qualification
# must establish that this b12x revision compiles and executes with 4.7.1.
ENV DS41_EXPECT_CUTLASS_DSL=4.7.1

# Karmic Kraken and b12x already include the prior dtype, program metadata,
# and collective-coordination fixes. Carry only the audited transport tweaks.
COPY patches/roce_karmic.py patches/probe_roce.c /opt/ds41/patches/
RUN python3 /opt/ds41/patches/roce_karmic.py /opt/b12x/b12x \
    && package="$(python3 -c "from importlib.metadata import distribution; print(distribution('b12x').locate_file('b12x'))")" \
    && python3 /opt/ds41/patches/roce_karmic.py "$package" \
    && python3 /opt/ds41/patches/roce_karmic.py "$package" --check \
    && cc -O2 -std=gnu11 -I"$package/comm/roce" /opt/ds41/patches/probe_roce.c \
       -libverbs -lpthread -o /opt/ds41/patches/probe_roce \
    && /opt/ds41/patches/probe_roce

COPY image-check.py model-check.py roce-check.py /opt/ds41/
RUN test -f "$CUDA_HOME/lib64/stubs/libcuda.so" \
    && LIBRARY_PATH="$CUDA_HOME/lib64/stubs${LIBRARY_PATH:+:$LIBRARY_PATH}" \
       python3 /opt/ds41/image-check.py \
    && python3 -m pip freeze > /opt/ds41/pip-freeze.txt
LABEL org.opencontainers.image.title="DeepSeek V4.1 Flash Karmic Kraken TP4 ARM64 SM121" \
      org.opencontainers.image.revision="${VLLM_COMMIT}" \
      local-inference.b12x.commit="${B12X_COMMIT}" \
      local-inference.roce-overlay="ds41-roce-v1"
WORKDIR /opt/ds41
ENTRYPOINT []
CMD ["vllm", "--help"]
