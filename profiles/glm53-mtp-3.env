# Throughput candidate after mtp-1 passes. Three draft tokens avoids the weak
# fourth-position acceptance reported by early GLM-5.3 Spark measurements.
ENFORCE_EAGER=0
VERIFY_CUDA_GRAPHS=1
COMPILATION_CONFIG='{"cudagraph_mode":"FULL_AND_PIECEWISE"}'
MAX_NUM_BATCHED_TOKENS=32768
ASYNC_SCHEDULING=1
MTP_SPECULATIVE_TOKENS=3
MTP_DRAFT_TP_SIZE=4
MTP_USE_LOCAL_ARGMAX_REDUCTION=1
MTP_DRAFT_SAMPLE_METHOD=greedy
MTP_REJECTION_SAMPLE_METHOD=standard
