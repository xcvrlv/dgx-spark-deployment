# Stage 2: one draft token, retaining graph shapes divisible by MTP + 1.
# shellcheck shell=bash
ENFORCE_EAGER=0
VERIFY_CUDA_GRAPHS=1
MTP_SPECULATIVE_TOKENS=1
MTP_USE_LOCAL_ARGMAX_REDUCTION=1
MTP_DRAFT_SAMPLE_METHOD=greedy
ASYNC_SCHEDULING=0
MAX_NUM_BATCHED_TOKENS=4096
COMPILATION_CONFIG='{"cudagraph_mode":"FULL_AND_PIECEWISE","cudagraph_capture_sizes":[2,4,6,8],"custom_ops":["all"],"pass_config":{"fuse_allreduce_rms":false}}'
