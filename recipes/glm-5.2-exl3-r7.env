# Full GLM-5.2 R7 EXL3: conservative TP4 baseline for four DGX Sparks.
# shellcheck shell=bash

# This checkpoint is rank-sliced for TP4. Do not change TP or revision without
# validating the replacement checkpoint's EXL3 tensor contract.
MODEL_ID=brandonmusic/GLM-5.2-EXL3-TR3v4-3.5bpw-MTP78
MODEL_REVISION=9ab9579774cc432df91567a36f6e9e863e0d4c9f
MODEL_HOST_PATH=/var/tmp/glm-5.2-exl3-r7
MODEL_CONTAINER_PATH=/models/glm-5.2-exl3-r7

# Build the immutable local-inference-lab r34 source composition against the
# ARM64 CUDA base on rank 0, then stream that exact image to the other Sparks.
IMAGE=spark-vllm-glm52-exl3:sm121-r34-v1
BUILD_IMAGE=1
PULL_IMAGE=0
CONTAINER_NAME=vllm_glm52_exl3

SERVED_MODEL_NAME=glm-5.2-exl3-r7-3.5bpw
API_PORT=8000
MASTER_PORT=29522
MAX_MODEL_LEN=65536
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=2048
GPU_MEMORY_UTILIZATION=0.84
BLOCK_SIZE=256
QUANTIZATION=exl3
LINEAR_BACKEND=auto
ATTENTION_BACKEND=B12X_MLA_SPARSE
MOE_BACKEND=b12x
KDA_PREFILL_BACKEND=
LOAD_FORMAT=instanttensor
ENABLE_CHUNKED_PREFILL=1
ENABLE_PREFIX_CACHING=1
ASYNC_SCHEDULING=0
DISABLE_CUSTOM_ALL_REDUCE=1
KERNEL_CONFIG=
COMPILATION_CONFIG=
VERIFY_CUDA_GRAPHS=0

# Encode the checkpoint's eligible BF16 dense/shared projections to persistent
# Trellis K6 artifacts. A cold cache can take well over 15 minutes per rank.
ONLINE_QUANT=exl3-b6
ONLINE_QUANT_CONFIG='{"linear":{"weight":"mxfp8"},"shared_experts":{"weight":"mxfp8"},"ignore":["re:.*\\.fused_qkv_a_proj$","re:.*\\.q_a_proj$","re:.*kv_a_proj_with_mqa","re:.*\\.mlp\\.gate$","model.layers.78.eh_proj","lm_head"]}'
VLLM_EXL3_PREFILL_CAPACITY=2048

# B12X kernels remain local to each rank. Its PCIe peer-DMA collectives are a
# single-host optimization and must stay disabled across the RoCE fabric.
B12X_PCIE_DMA=0

# Establish target-only correctness before applying the graph/MTP profiles.
MTP_SPECULATIVE_TOKENS=0
MTP_DRAFT_TP_SIZE=4
MTP_MOE_BACKEND=triton
MTP_USE_LOCAL_ARGMAX_REDUCTION=0
MTP_DRAFT_SAMPLE_METHOD=greedy
MTP_REJECTION_SAMPLE_METHOD=standard
KV_CACHE_DTYPE=nvfp4_ds_mla
KV_CACHE_MEMORY_BYTES=
ENFORCE_EAGER=1

INSTANTTENSOR_BACKEND=BUFFERED
INSTANTTENSOR_COPY=0
INSTANTTENSOR_BUFFER_SIZE=536870912
INSTANTTENSOR_CONCURRENCY=1
INSTANTTENSOR_IO_DEPTH=3
INSTANTTENSOR_CHUNK_SIZE=2097152
INSTANTTENSOR_MAX_FREE_MEM_USAGE=0.05

CONTAINER_MEMORY=112g
CONTAINER_SHM_SIZE=32g
CONTAINER_NOFILE=1048576
CACHE_HOST_PATH=/var/tmp/glm52-exl3-cache
LOG_HOST_PATH=/var/tmp/glm52-exl3-logs
HEALTH_TIMEOUT_SECONDS=7200
START_STAGGER_SECONDS=8
RUN_SMOKE_TEST=1
BENCHMARK_RUNS=3
BENCHMARK_WARMUPS=1
BENCHMARK_PREFILL_WORDS=8192
BENCHMARK_DECODE_TOKENS=256

CLUSTER_RAIL=CX0
FABRIC_IFACE=
NCCL_IB_HCA=
NCCL_IB_GID_INDEX=3
NCCL_IB_ADDR_RANGE=192.168.0.0/24
NCCL_DEBUG=WARN

ALLOW_UNVERIFIED_MODEL=0
