# GLM-5.3 Flash NVFP4: conservative TP4 baseline for four DGX Sparks.
# shellcheck shell=bash

# Keep the checkpoint immutable across every rank. Update the revision only
# after validating the replacement on the whole fleet.
MODEL_ID=local-inference-lab/GLM-5.3-Flash-NVFP4
MODEL_REVISION=8627752b10b78c2b0f2fc69790a94ec9f1ddaa26
MODEL_HOST_PATH=/var/tmp/glm-5.3-flash-nvfp4
MODEL_CONTAINER_PATH=/models/glm-5.3-flash-nvfp4

# Reproducible local SM121 image. `prepare` builds it on rank 0 and streams the
# exact image to ranks 1-3 before downloading model weights.
IMAGE=spark-vllm-glm53:sm121-v2
BUILD_IMAGE=1
PULL_IMAGE=0
CONTAINER_NAME=vllm_glm53

SERVED_MODEL_NAME=glm-5.3-flash
API_PORT=8000
MASTER_PORT=29521
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=32
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.80
BLOCK_SIZE=256
QUANTIZATION=modelopt_mixed
LINEAR_BACKEND=flashinfer_b12x
# FlashInfer CUTLASS enters a large SM121 JIT path and has produced incorrect
# GLM-5.3 output on GB10. Marlin is the validated first-iteration fallback.
MOE_BACKEND=marlin
KDA_PREFILL_BACKEND=flashkda
LOAD_FORMAT=instanttensor
ENABLE_CHUNKED_PREFILL=1
ENABLE_PREFIX_CACHING=1
ASYNC_SCHEDULING=1
DISABLE_CUSTOM_ALL_REDUCE=1
KERNEL_CONFIG='{"enable_cutedsl_warmup":false,"enable_flashinfer_autotune":false}'
COMPILATION_CONFIG=
VERIFY_CUDA_GRAPHS=0

# Iteration one validates ordinary decode first. Use the staged MTP profiles
# only after base output, tool calls, logprobs, and CUDA graphs pass.
MTP_SPECULATIVE_TOKENS=0
MTP_DRAFT_TP_SIZE=4
# The MTP layers are unquantized, so they cannot inherit the target model's
# NVFP4-only Marlin MoE backend.
MTP_MOE_BACKEND=triton
MTP_USE_LOCAL_ARGMAX_REDUCTION=0
MTP_DRAFT_SAMPLE_METHOD=greedy
MTP_REJECTION_SAMPLE_METHOD=standard
KV_CACHE_DTYPE=fp8
KV_CACHE_MEMORY_BYTES=8589934592
ENFORCE_EAGER=1

# Rank-local InstantTensor settings validated on GB10 unified memory.
INSTANTTENSOR_BACKEND=AIO_BUFFERED
INSTANTTENSOR_BUFFER_SIZE=1268776960
INSTANTTENSOR_CONCURRENCY=1
INSTANTTENSOR_IO_DEPTH=3
INSTANTTENSOR_CHUNK_SIZE=2097152
INSTANTTENSOR_MAX_FREE_MEM_USAGE=0.05

CONTAINER_MEMORY=112g
CONTAINER_SHM_SIZE=32g
CONTAINER_NOFILE=1048576
CACHE_HOST_PATH=/var/tmp/glm53-vllm-cache
LOG_HOST_PATH=/var/tmp/glm53-vllm-logs
HEALTH_TIMEOUT_SECONDS=3600
START_STAGGER_SECONDS=8
RUN_SMOKE_TEST=1
BENCHMARK_RUNS=3
BENCHMARK_WARMUPS=1
BENCHMARK_PREFILL_WORDS=8192
BENCHMARK_DECODE_TOKENS=256

# CX0 is the initial single-rail fabric. The launcher resolves the Linux netdev
# and RDMA HCA from each node's inventory address, so interface names need not
# be identical. FABRIC_IFACE and NCCL_IB_HCA remain available as overrides.
CLUSTER_RAIL=CX0
FABRIC_IFACE=
NCCL_IB_HCA=
NCCL_IB_GID_INDEX=3
NCCL_IB_ADDR_RANGE=192.168.0.0/24
NCCL_DEBUG=WARN

# Reject model directories which were not created by this recipe's pinned
# download. Set to 1 only when an externally verified shared mount is used.
ALLOW_UNVERIFIED_MODEL=0
